@model List<Product>
@{
    ViewData["Title"] = "My Wishlist";
}


<div id="empty-wishlist" class="text-center p-5 shadow-sm rounded d-none">
    <i class="bi bi-heart fs-1 text-secondary"></i>
    <h5 class="mt-3">Your wishlist is empty</h5>
    <p class="text-muted">Save items you love for later</p>

    <a asp-area="Customer" asp-controller="Home" asp-action="Index"
       class="btn btn-primary">
        Browse Products
    </a>
</div>


<div class="row g-4" id="wishlist-items">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm rounded-4">
                @* <img src="@item.ImageURL"
                     class="card-img-top p-3"
                     style="height:200px; object-fit:contain;" /> *@

                <div class="card-body">
                    <h6 class="fw-bold">@item.Title</h6>
                    <p class="text-muted small">@item.Description</p>

                    <h5 class="text-primary">
                        $@item.Price
                    </h5>
                </div>


                <div class="card-footer bg-white border-0 d-flex justify-content-between">
                    <button class="btn btn-sm btn-outline-primary move-to-cart"
                            data-id="@item.Id">
                        <i class="bi bi-cart"></i> Move to Cart
                    </button>

                    <button class="btn btn-sm btn-outline-danger remove-wishlist"
                            data-id="@item.Id">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>

            </div>
        </div>
    }
</div>

@section Scripts {
    <script>


           function ShowListEmptyData() {
                var wishList = $("#wishlist-items .col-md-4");

                if (wishList.length === 0) {
                    $("#wishlist-items").hide();
                    $("#empty-wishlist").removeClass("d-none");
                }
           }


        $(document).ready(ShowListEmptyData);


           $(document).on("click",".remove-wishlist",function(e){
                var btn = $(this);
                var productId = btn.data("id");
                console.log(productId);
            $.ajax({
                url:`/Customer/WishList/RemoveSessionItem`,
                type:"post",
                data:{productId:productId},
                success: function(response){
                   btn.closest(".col-md-4").fadeOut(function (){
                       $(this).remove();//Remove the card from DOM

                      ShowListEmptyData();
                   });


                   if(response.success){
                       toastr.success(response.message);
                   }
                },

                error:function (){
                     toastr.error("Failed to remove");
                }
             });
        });


         $(document).on("click",".move-to-cart",function(e){
                var btn = $(this);
                var productId = btn.data("id");
                console.log(productId);
            $.ajax({
                url:`/Customer/Home/AddToCart`,
                type:"delete",
                type:"POST",

                data: { productId: productId },
                success: function(response){
                        btn.closest(".col-md-4").fadeOut();

                },
                error:function (){
                    toastr.error("Please login to continue");
                }
             });
        });


    </script>
}