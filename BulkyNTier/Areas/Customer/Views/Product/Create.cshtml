@model Product



<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Create Products</h2>
            </div>
        </div>
    </div>

    <div class="card-body p-4">
        <form method="post" class="row g-3">
            <!-- g-3 gives spacing between fields -->
            @*<div asp-validation-summary="ModelOnly"></div>*@

            <!-- Each input wrapped in col-12 for small screens, col-lg-6 for large -->
            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input asp-for="Title" class="form-control border-0 shadow" />
                    <label class="ms-2">Title</label>
                    <span class="text-danger" asp-validation-for="Title"></span>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input asp-for="Description" class="form-control border-0 shadow" />
                    <label class="ms-2">Description</label>
                    <span class="text-danger" asp-validation-for="Description"></span>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input asp-for="Author" class="form-control border-0 shadow" />
                    <label class="ms-2">Author</label>
                    <span class="text-danger" asp-validation-for="Author"></span>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input asp-for="ISBN" class="form-control border-0 shadow" />
                    <label class="ms-2">ISBN</label>
                    <span class="text-danger" asp-validation-for="ISBN"></span>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input asp-for="ListPrice" class="form-control border-0 shadow" />
                    <label class="ms-2">List Price</label>
                    <span class="text-danger" asp-validation-for="ListPrice"></span>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input asp-for="Price" class="form-control border-0 shadow" />
                    <label class="ms-2">Price</label>
                    <span class="text-danger" asp-validation-for="Price"></span>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input asp-for="Price50" class="form-control border-0 shadow" />
                    <label class="ms-2">Price50</label>
                    <span class="text-danger" asp-validation-for="Price50"></span>
                </div>     
            </div>

            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input asp-for="Price100" class="form-control border-0 shadow" />
                    <label class="ms-2">Price100</label>
                    <span class="text-danger" asp-validation-for="Price100"></span>
                </div>
            </div>

            <!-- Buttons -->
            <div class="col-12 d-flex justify-content-start gap-3 pt-3">
                <button type="submit" class="btn btn-primary px-4">Create</button>
                <a asp-area="Customer" asp-controller="Product" asp-action="Index"
                   class="btn btn-outline-primary border-black px-4">Back to List</a>
            </div>
        </form>
    </div>
</div>





@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial.cshtml" />
    }
}
