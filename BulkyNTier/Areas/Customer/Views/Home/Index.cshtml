@model List<Product>

<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-md-3 col-sm-6 mb-4">
            <div class="card h-100 border-0 shadow-sm book-card">
                <div class="position-relative">
                    <img src="@product.ImageURL"
                         class="card-img-top book-image"
                         alt="@product.Title" />

                    <span class="badge bg-danger position-absolute top-0 start-0 m-2 book-badge">
                        -@((int)((1 - (product.Price / product.ListPrice)) * 100))%
                    </span>
                </div>

                <div class="card-body d-flex flex-column">
                    <h6 class="card-title fw-bold mb-1 text-truncate" title="@product.Title">
                        @product.Title
                    </h6>

                    <p class="text-muted small mb-2">
                        by @product.Author
                    </p>

                    <div class="mt-auto">
                        <div class="d-flex align-items-baseline gap-2">
                            <span class="fw-semibold fs-6 text-success">
                                ₹@product.Price
                            </span>
                            <span class="text-muted text-decoration-line-through small">
                                ₹@product.ListPrice
                            </span>
                        </div>

                        <a asp-action="Details" asp-route-id="@product.Id"
                           class="btn btn-sm btn-primary w-100 mt-3">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
