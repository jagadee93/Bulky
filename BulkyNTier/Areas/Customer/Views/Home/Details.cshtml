@model BulkyNTier.Models.ShoppingCart

@{
    ViewData["Title"] = Model.Product.Title;
}

<div class="container py-4">
    <a asp-action="Index" class="text-decoration-none mb-3 d-inline-flex align-items-center">
        <i class="bi bi-arrow-left me-1"></i> Back to products
    </a>

    <div class="row g-4 align-items-start">
        <!-- LEFT: Cover -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm book-card">
                <img src="@Model.Product.ImageURL"
                     alt="@Model.Product.Title"
                     class="card-img-top book-image-large" />
            </div>
        </div>

        <!-- RIGHT: Details -->
        <form class="col-md-8"  method="post">
            <div class="card border-0 shadow-sm p-4 h-100 book-details-card">
                <h2 class="fw-bold mb-1">@Model.Product.Title</h2>
                <input asp-for="ProductId" hidden />
                <p class="text-muted mb-3">
                    by <span class="fw-semibold">@Model.Product.Author</span>
                </p>

                <div class="mb-3">
                    <span class="badge bg-secondary me-2">ISBN: @Model.Product.ISBN</span>
                    <span class="badge bg-info-subtle text-dark">
                        Category: @Model.Product.Category?.Name
                    </span>
                </div>

                <div class="mb-4">
                    <span class="fs-3 fw-bold text-success me-3">
                        ₹@Model.Product.Price
                    </span>
                    <span class="fs-6 text-muted text-decoration-line-through">
                        ₹@Model.Product.ListPrice
                    </span>
                    <div class="small text-muted mt-1">
                        50+ : ₹@Model.Product.Price50 &nbsp;|&nbsp; 100+ : ₹@Model.Product.Price100
                    </div>
                </div>

                <h5 class="fw-semibold mb-2">Description</h5>
                <p class="text-muted" style="white-space: pre-line;">
                    @Html.Raw(Model.Product.Description)
                </p>

                <div class="mt-4 d-flex flex-wrap gap-2">
                    

                    <div class="form-floating">
                        <input asp-for="Count" class="form-control border-0 shadow" />
                        <label asp-for="Count" class="ms-2"></label>
                        <span class="text-danger" asp-validation-for="Count"></span>
                    </div>

                    <button class="btn btn-primary px-4" asp-controller="Home" asp-action="AddToCart">
                        <i class="bi bi-cart-plus me-1"></i> Add to cart
                    </button>
                    <button asp-asp-controller="Home" asp-action="AddTowishList" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-heart me-1"></i> Add to wishlist
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial.cshtml" />
    }
}