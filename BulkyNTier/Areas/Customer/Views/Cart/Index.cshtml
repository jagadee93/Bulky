

@model ShoppingCartListVM

@{
    ViewData["Title"] = "Shopping Cart";
    double total = 0;
}

<div class="container cart-container py-4">

    <h2 class="fw-bold mb-4">Your Cart</h2>

    @if (!Model.ShoppingCartList.Any())
    {
        <div class="empty-cart text-center p-5 shadow-sm rounded-3">
            <i class="bi bi-cart-x fs-1 text-secondary"></i>
            <h5 class="mt-3">Your cart is empty</h5>
            <p class="text-muted">Add something to make it happy 😊</p>

            <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn btn-primary">
                Continue Shopping
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">

            <!-- LEFT: items -->
            <div class="col-lg-8">

                <div class="card cart-card shadow-sm p-3">

                    <table class="table align-middle mb-0">
                        <tbody>

                            @foreach (var item in Model.ShoppingCartList)
                            {
                                var subtotal = item.Count * item.Price;

                                total += item.Count*item.Product.Price;


                                <tr class="cart-row">

                                    <td width="120">
                                       <a asp-controller="Home" asp-action="Details" asp-route-id="@item.ProductId">
                                        <img src="@item.Product.ImageURL"
                                             class="cart-img"
                                             alt="@item.Product.Title" />
                                        </a>
                                    </td>

                                    <td>
                                        <a asp-controller="Home" asp-action="Details" asp-route-id="@item.ProductId"> <h6 class="fw-semibold mb-1">@item.Product.Title</h6></a>
                                        <small class="text-muted">ISBN: @item.Product.ISBN</small>

                                        <div class="text-success fw-bold mt-2">
                                            ₹@item.Price
                                        </div>
                                    </td>

                                    <td width="170">
                                        <div class="qty-control">
                                            <a asp-action="Minus" asp-route-cartId="@item.Id" class="btn btn-sm btn-light">−</a>

                                            <span class="qty-box">@item.Count</span>

                                            <a asp-action="Plus" asp-route-cartId="@item.Id" class="btn btn-sm btn-light">+</a>
                                        </div>
                                    </td>

                                    <td width="140" class="fw-semibold">
                                        ₹@subtotal
                                    </td>

                                    <td width="120">
                                        <a asp-action="RemoveSingleItemFromCart"
                                           asp-route-cartId="@item.Id"
                                           class="btn btn-outline-danger btn-sm">
                                            Remove
                                        </a>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>

            <!-- RIGHT: summary -->
            <div class="col-lg-4">

                <div class="card shadow-sm p-4 order-summary">
                    <h5 class="fw-bold mb-3">Order Summary</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Items Total</span>
                        <span style="text-decoration: line-through" class="fw-bold">₹@total</span>
                        <span class="fw-bold">₹@Model.Total</span>
                    </div>

                    <hr />

                    <div class="d-grid mt-3">
                        <a asp-action="Summary" class="btn btn-primary btn-lg">
                            Proceed to Checkout
                        </a>
                    </div>
                </div>

            </div>

        </div>
    }
</div>
