@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-start">

        <!-- LOCAL LOGIN -->
        <div class="col-md-5">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4">

                    <h3 class="text-center fw-bold mb-2">Welcome Back</h3>
                    <p class="text-center text-muted mb-4">
                        Log in to your account
                    </p>

                    <form method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3"></div>

                        <!-- EMAIL -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email"
                                   class="form-control rounded-3"
                                   autocomplete="username"
                                   placeholder="Email" />
                            <label asp-for="Input.Email"></label>
                            <span asp-validation-for="Input.Email"
                                  class="text-danger small"></span>
                        </div>

                        <!-- PASSWORD -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password"
                                   class="form-control rounded-3"
                                   autocomplete="current-password"
                                   placeholder="Password" />
                            <label asp-for="Input.Password"></label>
                            <span asp-validation-for="Input.Password"
                                  class="text-danger small"></span>
                        </div>

                        <!-- REMEMBER ME -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="form-check">
                                <input asp-for="Input.RememberMe"
                                       class="form-check-input"
                                       id="rememberMe" />
                                <label class="form-check-label"
                                       asp-for="Input.RememberMe">
                                    Remember me
                                </label>
                            </div>

                            <a asp-page="./ForgotPassword"
                               class="small text-decoration-none">
                                Forgot password?
                            </a>
                        </div>

                        <!-- SUBMIT -->
                        <button type="submit"
                                class="btn btn-primary w-100 py-2 rounded-3 fw-semibold">
                            Log in
                        </button>

                        <!-- LINKS -->
                        <div class="text-center mt-4 small">
                            <p class="mb-1">
                                Don’t have an account?
                                <a asp-page="./Register"
                                   asp-route-returnUrl="@Model.ReturnUrl">
                                    Register
                                </a>
                            </p>
                            <p class="mb-0">
                                <a asp-page="./ResendEmailConfirmation">
                                    Resend confirmation email
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- EXTERNAL LOGIN -->
        <div class="col-md-4 mt-4 mt-md-0">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 text-center">

                    <h5 class="fw-semibold mb-3">Or continue with</h5>

                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <form asp-page="./ExternalLogin"
                              asp-route-returnUrl="@Model.ReturnUrl"
                              method="post">

                            <div class="d-grid gap-2">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit"
                                            name="provider"
                                            value="@provider.Name"
                                            class="btn btn-outline-dark rounded-3 py-2">
                                        Continue with @provider.DisplayName
                                    </button>
                                }
                            </div>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted small">
                            No external login providers configured.
                        </p>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
