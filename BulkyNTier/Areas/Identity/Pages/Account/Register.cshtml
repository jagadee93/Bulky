@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
    bool isAdmin = User.IsInRole(SD.Role_Admin);
}

<div class="container py-5">
    <div class="row justify-content-center">

        <!-- REGISTER CARD -->
        <div class="col-md-5">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4">

                    <h3 class="text-center fw-bold mb-2">
                        @(isAdmin ? "Register New User" : "Create an Account")
                    </h3>

                    <p class="text-center text-muted mb-4">
                        @(isAdmin ? "Admin user creation" : "Sign up to get started")
                    </p>

                    <form asp-route-returnUrl="@Model.ReturnUrl" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger small mb-3"></div>

                        <!-- Email -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email"
                                   class="form-control rounded-3"
                                   placeholder="Email" />
                            <label asp-for="Input.Email"></label>
                        </div>

                        <!-- Password -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password"
                                   class="form-control rounded-3"
                                   placeholder="Password" />
                            <label asp-for="Input.Password"></label>
                        </div>

                        <!-- Confirm -->
                        <div class="form-floating mb-3">
                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control rounded-3"
                                   placeholder="Confirm Password" />
                            <label asp-for="Input.ConfirmPassword"></label>
                        </div>

                        <!-- ADMIN FIELDS -->
                        @if (isAdmin)
                        {
                            <div class="form-floating mb-3">
                                <select asp-for="Input.Role"
                                        asp-items="Model.Input.RoleList"
                                        class="form-select rounded-3"
                                        id="roleSelect">
                                    <option value="">Select Role</option>
                                </select>
                                <label asp-for="Input.Role"></label>
                            </div>

                            <div class="form-floating mb-3 d-none" id="companyWrapper">
                                <select asp-for="Input.CompanyId"
                                        asp-items="Model.Input.CompaniesList"
                                        class="form-select rounded-3">
                                    <option value="">Select Company</option>
                                </select>
                                <label asp-for="Input.CompanyId"></label>
                            </div>
                        }

                        <button type="submit"
                                class="btn btn-primary w-100 py-2 rounded-3 fw-semibold">
                            Register
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- EXTERNAL LOGIN -->
        @if (!isAdmin)
        {
            <div class="col-md-4 mt-4 mt-md-0">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4 text-center">

                        <h5 class="fw-semibold mb-3">Or continue with</h5>

                        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                        {
                            <form asp-page="./ExternalLogin"
                                  asp-route-returnUrl="@Model.ReturnUrl"
                                  method="post">

                                <div class="d-grid gap-2">
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit"
                                                name="provider"
                                                value="@provider.Name"
                                                class="btn btn-outline-dark rounded-3 py-2">
                                            Continue with @provider.DisplayName
                                        </button>
                                    }
                                </div>
                            </form>
                        }
                        else
                        {
                            <p class="text-muted small">
                                No external providers configured
                            </p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            $('#roleSelect').on('change', function () {
                const isCompany = $(this).find('option:selected').text() === 'Company';
                $('#companyWrapper').toggleClass('d-none', !isCompany);
            });
        });
    </script>
}
