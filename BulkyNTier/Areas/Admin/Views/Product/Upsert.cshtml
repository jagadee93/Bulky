@model ProductVM


<div class="container mt-4">
    <div class="card shadow-lg border-0">

        <!-- HEADER -->
        <div class="card-header bg-dark text-white py-3 text-center">
            <h3 class="mb-0">
                @(Model.Product.Id != 0 ? "Edit Product" : "Create Product")
            </h3>
        </div>

        <div class="card-body p-4">

            <form method="post"
                  asp-action="Upsert"
                  enctype="multipart/form-data">

                <input asp-for="Product.Id" hidden />

                <div class="row g-4">

                    <!-- LEFT COLUMN (FORM DATA) -->
                    <div class="col-lg-8">

                        <h5 class="border-bottom pb-2 mb-3">Product Information</h5>

                        <div class="form-floating mb-3">
                            <input asp-for="Product.Title" class="form-control shadow-sm" />
                            <label asp-for="Product.Title"></label>
                            <span asp-validation-for="Product.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Product.Description" class="fw-semibold"></label>
                            <textarea asp-for="Product.Description"
                                      class="form-control"
                                      rows="6"></textarea>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Product.Author" class="form-control shadow-sm" />
                                    <label asp-for="Product.Author"></label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Product.ISBN" class="form-control shadow-sm" />
                                    <label asp-for="Product.ISBN"></label>
                                </div>
                            </div>
                        </div>

                        <h5 class="border-bottom pb-2 mt-4 mb-3">Pricing</h5>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="Product.ListPrice" class="form-control shadow-sm" />
                                    <label asp-for="Product.ListPrice"></label>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="Product.Price" class="form-control shadow-sm" />
                                    <label asp-for="Product.Price"></label>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="Product.Price50" class="form-control shadow-sm" />
                                    <label asp-for="Product.Price50"></label>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mt-2">
                            <div class="col-md-4">
                                <div class="form-floating">
                                    <input asp-for="Product.Price100" class="form-control shadow-sm" />
                                    <label asp-for="Product.Price100"></label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="Product.CategoryId"
                                            asp-items="Model.CategoryList"
                                            class="form-select shadow-sm">
                                        <option disabled selected>Select Category</option>
                                    </select>
                                    <label asp-for="Product.CategoryId"></label>
                                </div>
                            </div>
                        </div>

                        <!-- ACTION BUTTONS -->
                        <div class="mt-4 border-top pt-3 d-flex gap-3">
                            <a asp-controller="Product"
                               asp-action="Index"
                               class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>

                            <button type="submit" class="btn btn-primary px-5">
                                @(Model.Product.Id != 0 ? "Update" : "Create")
                            </button>
                        </div>

                    </div>


                    <!-- RIGHT COLUMN (IMAGES PANEL) -->
                    <div class="col-lg-4">

                        <div class="image-panel p-3 border rounded shadow-sm">

                            <h6 class="fw-bold mb-3">Product Images</h6>

                            <div class="image-gallery d-flex flex-wrap gap-2 mb-3">
                                @if (Model.Product.ProductImages?.Any() == true)
                                {
                                    foreach (var img in Model.Product.ProductImages)
                                    {
                                        <div>
                                        <img src="@img.ImageURL"
                                             class="img-thumbnail product-thumb"
                                             data-bs-toggle="modal"
                                             data-bs-target="#imagePreviewModal"
                                             data-img-url="@img.ImageURL"
                                             style="width: 80px; height: 100px; object-fit: cover; cursor: pointer;" />
                                            <a asp-action="DeleteImage" asp-route-id="@img.Id"><i class="bi bi-trash"></i></a>
                                        </div>
                                        
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">No images uploaded</span>
                                }
                            </div>
                            <div class="upload-wrapper">

                                <input type="file"
                                       id="fileUpload"
                                       name="files"
                                       class="d-none"
                                       multiple />

                                <label for="fileUpload" class="upload-box text-center">
                                    <div>
                                        <i class="bi bi-cloud-arrow-up fs-2"></i>
                                        <p class="mb-1 fw-semibold">Click or Drag Images Here</p>
                                        <small class="text-muted">PNG, JPG, WEBP allowed</small>
                                    </div>
                                </label>

                                <div id="fileList" class="mt-2 small text-muted"></div>

                            </div>


                        </div>

                    </div>

                </div>
            </form>

        </div>
    </div>
</div>



<div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">

            <div class="modal-header border-0">
                <h5 class="modal-title">Image Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body text-center">
                <img id="modalImage"
                     src=""
                     class="img-fluid rounded"
                     style="max-height: 80vh;" />
            </div>

        </div>
    </div>
</div>




@section Scripts {

    @{
        <partial name="_ValidationScriptsPartial.cshtml" />
    }
    <script>
           $(document).on("click", ".img-thumbnail", function () {
            $("#modalImage").attr("src", $(this).data("img-url"));
        });



        $("#fileUpload").on("change",function(){
            let fileNames=[];

        });


    </script>
}

