@model ProductVM



<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">@(Model.Product.Id!=0?"Edit":"Create")Product</h2>
            </div>
        </div>
    </div>

    <div class="card-body p-4">
        <form method="post" asp-action="Upsert" class="row g-3" enctype="multipart/form-data">
            <!-- g-3 gives spacing between fields -->
            @*<div asp-validation-summary="ModelOnly"></div>*@


            <input asp-for="Product.Id" hidden />
            <input asp-for="Product.ImageURL" hidden /> 
            <!-- Each input wrapped in col-12 for small screens, col-lg-6 for large -->
            <div class="col-12 col-lg-12">
                <div class="form-floating">
                    <input asp-for="Product.Title" class="form-control border-0 shadow" />
                    <label asp-for="Product.Title" class="ms-2"></label>
                    <span class="text-danger" asp-validation-for="Product.Title"></span>
                </div>
            </div>

            <div class="row">
                <!-- Left column: Description -->
                <div class="col-12 col-lg-8">
                    <label asp-for="Product.Description" class="ms-2"></label>
                    <textarea asp-for="Product.Description"
                              class="form-control text-muted"
                              rows="8"
                              cols="40"></textarea>
                </div>

                <!-- Right column: Image -->
                <div class="col-12 col-lg-4 d-flex align-items-start">
                    <img src="@Model.Product.ImageURL" class="img-fluid border rounded" width="200" />
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input asp-for="Product.Author" class="form-control border-0 shadow" />
                    <label asp-for="Product.Author" class="ms-2"></label>
                    <span class="text-danger" asp-validation-for="Product.Author"></span>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input type="file" name="file" class="form-control border-0 shadow" />
                    <label asp-for="Product.ImageURL" class="ms-2"></label>

                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input asp-for="Product.ISBN" class="form-control border-0 shadow" />
                    <label asp-for="Product.ISBN" class="ms-2"></label>
                    <span class="text-danger" asp-validation-for="Product.ISBN"></span>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input asp-for="Product.ListPrice" class="form-control border-0 shadow" />
                    <label asp-for="Product.ListPrice" class="ms-2"></label>
                    <span class="text-danger" asp-validation-for="Product.ListPrice"></span>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input asp-for="Product.Price" class="form-control border-0 shadow" />
                    <label asp-for="Product.Price" class="ms-2"></label>
                    <span class="text-danger" asp-validation-for="Product.Price"></span>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input asp-for="Product.Price50" class="form-control border-0 shadow" />
                    <label asp-for="Product.Price50" class="ms-2"></label>
                    <span class="text-danger" asp-validation-for="Product.Price50"></span>
                </div>     
            </div>

            <div class="col-12 col-lg-6">
                <div class="form-floating">
                    <input asp-for="Product.Price100" class="form-control border-0 shadow" />
                    <label asp-for="Product.Price100" class="ms-2"></label>
                    <span class="text-danger" asp-validation-for="Product.Price100"></span>
                </div>
            </div>




            <div class="col-12 col-lg-6">
                <div class="form-floating">
                  @* <select asp-for="CategoryId" asp-items="ViewBag.CategoryList" class="form-select border-0 shadow-1"> *@
                 @* <select asp-for="CategoryId" asp-items="@(ViewData["CategoryList"] as IEnumerable<SelectListItem> )" class="form-select border-0 shadow-1"> *@
                    <select asp-for="@Model.Product.CategoryId" asp-items="@Model.CategoryList" class="form-select border-0 shadow-1">
                        <option disabled>Select Category</option>
                    </select>
                    <label asp-for="@Model.Product.CategoryId" class="ms-2"></label>
                    
                </div>
            </div>



            <!-- Buttons -->

            <div class="col-12 d-flex justify-content-start gap-3 pt-3">

                @if (Model.Product.Id != 0)
                {
                    <button type="submit" asp-action="Upsert" class="btn btn-primary px-4">Update</button>
                }
                else
                {
                    <button type="submit" asp-action="Upsert" class="btn btn-primary px-4">Create</button>
                }
                
                <a asp-area="Customer" asp-controller="Product" asp-action="Index"
                   class="btn btn-outline-primary border-black px-4">Back to List</a>
            </div>
        </form>
    </div>
</div>





@section Scripts {

    <script>
        tinymce.init({
          selector: 'textarea',
          plugins: [
            // Core editing features
            'anchor', 'autolink', 'charmap', 'codesample', 'emoticons', 'lists' , 'table', 'visualblocks', 'wordcount',
            // Your account includes a free trial of TinyMCE premium features
            // Try the most popular premium features until Dec 2, 2025:
            'checklist', 'casechange', 'formatpainter', 'pageembed', 'a11ychecker', 'tinymcespellchecker', 'permanentpen', 'powerpaste', 'advtable', 'advcode', 'advtemplate', 'ai', 'tableofcontents', 'footnotes', 'mergetags', 'autocorrect', 'typography', 'inlinecss', 'markdown','importword', 'exportword', 'exportpdf'
          ],
          toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | table  | spellcheckdialog a11ycheck typography uploadcare | align lineheight | checklist numlist bullist indent outdent | emoticons charmap | removeformat',
          tinycomments_mode: 'embedded',
          tinycomments_author: 'Author name',
          mergetags_list: [
            { value: 'First.Name', title: 'First Name' },
            { value: 'Email', title: 'Email' },
          ],
          ai_request: (request, respondWith) => respondWith.string(() => Promise.reject('See docs to implement AI Assistant')),
          uploadcare_public_key: '464f8319697d6f369471',
        });
    </script>
    @{
        <partial name="_ValidationScriptsPartial.cshtml" />
    }
}
