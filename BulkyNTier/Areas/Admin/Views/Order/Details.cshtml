@model OrderHeader


@{
    ViewData["Title"] = "Details";
    var isAuthorized = User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Employee);
    var PaymentDisable = Model.PaymentStatus == PaymentStatus.Approved ? true : false;
}
<form method="post">
    <br />
    <input hidden asp-for="Id" />
    <div class="container">
        <div class="card">
            <div class="card-header bg-dark text-light ml-0">
                <div class="container row">
                    <div class="col-12 d-none d-md-block col-md-6 pb-1">
                        <i class="fas fa-shopping-cart"></i> &nbsp; Order Summary
                    </div>
                    <div class="col-12 col-md-4 offset-md-2 text-right">
                        <a class="btn btn-outline-info form-control btn-sm" asp-action="Index" asp-controller="Order">Back to Orders</a>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="container rounded p-2">
                    <div class="row">

                        <div class="col-12 col-lg-6 pb-4">
                            <div class="row">
                                <h4 class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="text-primary">PickUp Details:</span>
                                </h4>
                            </div>
                            <div class="row my-1">
                                <div class="col-3">Name</div>
                                <div class="col-9">
                                    <input asp-for="@Model.ShippingAddress.Name" readonly class="form-control" />

                                </div>
                            </div>
                            <div class="row my-1">
                                <div class="col-3">Phone</div>
                                <div class="col-9">
                                    <input asp-for="@Model.ShippingAddress.PhoneNumber" readonly class="form-control" />
                                </div>
                            </div>
                            <div class="row my-1">
                                <div class="col-3">Address</div>
                                <div class="col-9">
                                    <input asp-for="@Model.ShippingAddress.StreetAddress" readonly class="form-control" />
                                </div>
                            </div>
                            <div class="row my-1">
                                <div class="col-3">City</div>
                                <div class="col-9">
                                    <input asp-for="@Model.ShippingAddress.City" readonly class="form-control" />
                                </div>
                            </div>
                            <div class="row my-1">
                                <div class="col-3">State</div>
                                <div class="col-9">
                                    <input asp-for="@Model.ShippingAddress.State" readonly class="form-control" />
                                </div>
                            </div>
                            <div class="row my-1">
                                <div class="col-3">Zip Code</div>
                                <div class="col-9">
                                    <input asp-for="@Model.ShippingAddress.PostalCode" readonly class="form-control" />
                                </div>
                            </div>
                            <div class="row my-1">
                                <div class="col-3">Email</div>
                                <div class="col-9">
                                    <input value="@Model.ApplicationUser.Email" readonly class="form-control" />
                                </div>
                            </div>
                            <div class="row my-1">
                                <div class="col-3">Order Date</div>
                                <div class="col-9">
                                    <input value="@Model.OrderDate" readonly class="form-control" />
                                </div>
                            </div>
                            <div class="row my-1">
                                <div class="col-3">Carrier</div>
                                <div class="col-9">
                                    @if (isAuthorized)
                                    {
                                        <input asp-for="Carrier"  class="form-control shipping" />
                                        <span class="text-danger" asp-validation-for="Carrier"></span>
                                    }
                                    else
                                    {
                                        <input value="@Model.Carrier" readonly class="form-control shipping" />
                                    }
                                </div>
                            </div>
                            <div class="row my-1">
                                <div class="col-3">Tracking</div>
                                <div class="col-9">
                                    @if (isAuthorized)
                                    {
                                        <input asp-for="TrackingNumber" class="form-control shipping" />
                                        <span class="text-danger" asp-validation-for="TrackingNumber"></span>
                                    }
                                    else
                                    {
                                        <input value="@Model.TrackingNumber" readonly class="form-control shipping" />
                                    }
                                </div>
                            </div>
                            <div class="row my-1">
                                <div class="col-3">Shipping Date</div>
                                <div class="col-9">
                                    <input value="@Model.ExpectedShippingDate" readonly class="form-control" />
                                </div>
                            </div>

                            @if (isAuthorized)
                            {

                                <div class="row my-1">
                                    <div class="col-3">Session ID</div>
                                    <div class="col-9">
                                        <input value="@Model.SessionId" readonly class="form-control" />
                                    </div>
                                </div>
                                <div class="row my-1">
                                    <div class="col-3">Payment Intent ID</div>
                                    <div class="col-9">
                                        <input value="@Model.PaymentIntentId" readonly class="form-control" />
                                    </div>
                                </div>
                            }

                            @if (Model.SessionId == null)
                            {
                               
                                <div class="row my-1">
                                    <div class="col-3">Payment Due Date</div>
                                    <div class="col-9">
                                        @if(isAuthorized){

                                        <input asp-for="PaymentDueDate" type="date" asp-format="{0:yyyy-MM-dd}"  readonly class="form-control" />
                                        <span class="text-danger" asp-validation-for="PaymentDueDate"></span>
                                        }else{
                                        <input value="PaymentDueDate" type="date" asp-format="{0:yyyy-MM-dd}" readonly class="form-control" />
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="row my-1">
                                    <div class="col-3">Payment Date</div>
                                    <div class="col-9">
                                        <input value="@Model.PaymentDate" readonly class="form-control" />
                                        <span class="text-danger" asp-validation-for="PaymentDate"></span>
                                    </div>
                                </div>
                            }


                            <div class="row my-1">
                                <div class="col-3">Payment Status</div>
                                <div class="col-9">
                                    <input value="@Model.PaymentStatus" readonly class="form-control" />
                                </div>
                            </div>

                            @* @if (isAuthorized)
                            {
                                <button type="submit" id="btnEdit" asp-action="UpdateOrderDetail" class="btn btn-secondary form-control my-1">Edit Order</button>
                                
                            } *@
                        </div>

                        <div class="col-12 col-lg-5 offset-lg-1">
                            <h4 class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-primary">Order Summary</span>
                            </h4>


                            <div class="row my-1">
                                <div class="col-3">Order Status</div>
                                <div class="col-9">
                                    <select asp-for="OrderStatus" class="form-control" asp-items="Html.GetEnumSelectList<OrderStatus>()" disabled="@(Model.OrderStatus == @OrderStatus.Cancelled || !isAuthorized ? true : false)">
                                        <option disabled selected>--select Order stauts</option>
                                    </select>
                                </div>
                            </div>

                            <ul class="list-group mb-3">
                                @foreach (var item in Model.OrderDetails)
                                {
                                    <li class="list-group-item d-flex justify-content-between p-2">
                                        <div class="row container">
                                            <div class="col-8">
                                                <h6 class="my-0 text-primary">@item.Product.Title</h6>
                                                <small class="text-muted">Price : @item.Price</small><br />
                                                <small class="text-muted">Quantity : @item.Count</small>
                                            </div>
                                            <div class="col-4 text-end">
                                                <p class="text-success">@(item.Price* item.Count)</p>
                                            </div>
                                        </div>
                                    </li>
                                }

                                <li class="list-group-item bg-primary">
                                    <div class="row container">
                                        <div class="col-6">
                                            <h5 class="text-white">TOTAL </h5>
                                        </div>
                                        <div class="col-6 text-end">
                                            <h5 class="text-white">$@Model.OrderTotal</h5>
                                        </div>
                                    </div>
                                </li>     
                            </ul>

                            @if (Model.OrderStatus == OrderStatus.Shipped && Model.PaymentStatus == PaymentStatus.ApprovedForDelayedPayment)
                            {
                                <button type="submit" disabled="@(PaymentDisable)" class="btn btn-success form-control my-1">PayNow</button>
                            }

                            @if (isAuthorized)
                            {

                                if (Model.OrderStatus==OrderStatus.Approved)
                                {
                                    <button type="submit" asp-action="ProcessOrder" class="btn btn-primary form-control my-1">Start Processing</button>
                                }


                                if (Model.OrderStatus == OrderStatus.Processing)
                                {
                                    <button type="submit" class="btn btn-primary form-control my-1" asp-action="ShipOrder" onclick="return ValidateShippingDetails()">Ship Order</button>
                                }

                                if (Model.OrderStatus != OrderStatus.Cancelled && Model.OrderStatus!=OrderStatus.Shipped&& Model.PaymentStatus!=PaymentStatus.Refunded)
                                {
                                    <button type="submit" asp-action="Cancel" class="btn btn-danger form-control my-1">Cancel Order</button>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
@section Scripts {
    <script>


        function ValidateShippingDetails(){
            let fields=$(".shipping");
            let flag=true;
            for(i=0;i<fields.length;i++){
                if(fields[i].value.trim()==""){
                    flag=false;
                    break;
                }
            }
            if(!flag){
                 Swal.fire({
                        title: "Oops...",
                        text: "TrackingId and Carrier can not be empty",
                        icon: "error",
                       
                 });
            }
            return flag;
        };



        function ToggleEdit(){
            const btn = $("#btnEdit");
            const isAuthorized = btn.data("authorized") === true;

            const u="@isAuthorized";

            if(!isAuthorized){
               Swal.fire("Access Denied", "You do not have permission to edit this order.", "error");
                return;
            }
           const fields= $(".editable-field");


           if(fields.prop("readonly")){
               fields.prop("readonly",false).addClass("border-primary shadow-sm");
               btn.text("Cancel").removeClass("btn-secondary").addClass("btn-danger");
               $("#btnUpdate").removeClass("d-none");
           }else{
               fields.prop("readonly", true).removeClass("border-primary shadow-sm");
               btn.text("Edit Details").removeClass("btn-danger").addClass("btn-secondary");
               $("#btnUpdate").addClass("d-none");
           }

        }

    </script>

    @{
        <partial name="_ValidationScriptsPartial.cshtml" />
    }
}