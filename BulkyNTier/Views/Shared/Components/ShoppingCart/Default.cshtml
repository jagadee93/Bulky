@model int

<a asp-area="Customer" asp-controller="Cart" asp-action="Index"
   class="nav-link position-relative">

    <i class="bi bi-cart"></i> 

    @if (Model > 0)
    {
        <span class="badge bg-danger position-absolute top-0 start-100 translate-middle">
            @Model
        </span>
    }
</a>