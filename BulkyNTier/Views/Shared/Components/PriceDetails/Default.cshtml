
@model PriceDetailSummaryVM


<div class="card p-3 price-card">
    <h6 class="fw-bold mb-3">Price Details</h6>

    <div class="d-flex justify-content-between">
        <span>MRP (incl. of all taxes)</span>
        <span>₹@Model.TotalPrice</span>
    </div>

    <hr />

    <div class="d-flex justify-content-between">
        <span>Shipping Charges </span>
        <span>₹@Model.ShippingCharges</span>
    </div>

    <hr />

    <div class="d-flex justify-content-between text-success">
        <span>Discount on MRP</span>
        <span>- ₹@Model.DiscountTotal</span>
    </div>

    @* <div class="d-flex justify-content-between text-success">
        <span>Buy More Save More</span>
        <span>- ₹@Model.BuyMoreSaveMore</span>
    </div> *@

    <div class="d-flex justify-content-between text-success">
        <span>Coupons Applied</span>
        <span>- ₹@Model.CouponDiscount</span>
    </div>

    <hr />

    <div class="d-flex justify-content-between fw-bold">
        <span>Total Amount</span>
        <span>₹@Model.TotalPrice</span>
    </div>

    <div class="alert alert-success mt-3 p-2 text-center">
        You will save ₹@Model.TotalSavings on this order
    </div>
</div>
