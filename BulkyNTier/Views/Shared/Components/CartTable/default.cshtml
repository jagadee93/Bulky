@model CartTableVM

<table class="table align-middle mb-0 " id="cart-table">
    <tbody>
        @foreach (var item in Model.ShoppingCartList)
        {
            <tr class="cart-row cart-item">

                <td width="120">
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@item.ProductId">
                        @* <img src="@item.Product.ImageURL"
                             class="cart-img"
                             alt="@item.Product.Title" /> *@
                    </a>
                </td>

                <td>
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@item.ProductId"> <h6 class="fw-semibold mb-1">@item.Product.Title</h6></a>
                    <small class="text-muted">ISBN: @item.Product.ISBN</small>

                    <div class="text-success fw-bold mt-2">
                        ₹@item.Price
                    </div>
                </td>

                <td width="170">
                    <div class="qty-control">
                        <button onclick="UpdateCart('@Url.Action("Minus", "Cart", new { cartId = item.Id })')" asp-action="Minus" class="btn btn-sm btn-light">−</button>

                        <span class="qty-box">@item.Count</span>

                        <button onclick="UpdateCart('@Url.Action("Plus", "Cart", new { cartId = item.Id })')" class="btn btn-sm btn-light">+</button>
                    </div>
                </td>

                <td width="140" class="fw-semibold">
                    ₹ @((item.Count * item.Price))
                </td>

                <td width="120">
                    <button onclick="UpdateCart('@Url.Action("RemoveSingleItemFromCart", "Cart", new { cartId = item.Id })')"
                            class="btn btn-outline-danger btn-sm">
                        Remove
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
